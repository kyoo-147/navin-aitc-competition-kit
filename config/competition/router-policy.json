{
  "schema_version": 1,
  "policy": "evidence-gated-escalation",
  "runtime_source_of_truth": "/key/info",
  "tiers": {
    "T0": {
      "purpose": "deterministic tools",
      "model_required": false
    },
    "T1": {
      "purpose": "routine coding and clear fixes",
      "selection": "cheapest canary-proven compatible model",
      "max_attempts_before_review": 2
    },
    "T2": {
      "purpose": "cross-file design, ambiguous bugs, standard review",
      "selection": "best value from current task-relevant mini-benchmark"
    },
    "T3": {
      "purpose": "architecture, security, concurrency, hard root cause",
      "requires": ["verified_failure_evidence", "compacted_context"]
    },
    "T4": {
      "purpose": "score-critical emergency blocker",
      "requires": ["leader_approval", "per_request_cost_cap"]
    }
  },
  "escalation_evidence": [
    "two_bounded_attempts_same_verified_defect",
    "reviewer_rejection_with_reproduction",
    "required_capability_absent",
    "cheaper_retries_expected_to_cost_more"
  ],
  "retry": {
    "retryable_statuses": [429, 500, 502, 503, 504],
    "maximum_transient_retries": 2,
    "use_jitter": true,
    "never_retry_auth_failure": true
  }
}
